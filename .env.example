# Gmail OAuth credentials (download from Google Cloud Console)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_POLL_INTERVAL_SECONDS=30

# Bland.ai Voice API
BLAND_API_KEY=your_bland_api_key

# Rocketlane
ROCKETLANE_API_KEY=your_rocketlane_api_key
ROCKETLANE_API_URL=https://api.rocketlane.com/api/1.0

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# LLM Provider — "groq" (free, recommended) or "anthropic"
LLM_PROVIDER=groq

# Groq (free tier — sign up at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (alternative — paid)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# Escalation
ESCALATION_EMAIL=cs-manager@novacrm.com
