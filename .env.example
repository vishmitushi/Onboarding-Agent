# Gmail (IMAP with App Password — no Google Cloud project needed)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_POLL_INTERVAL_SECONDS=30

# Bland.ai Voice API https://bland.ai
BLAND_API_KEY=your_bland_api_key

# Rocketlane
ROCKETLANE_API_KEY=your_rocketlane_api_key
ROCKETLANE_API_URL=https://api.rocketlane.com/api/1.0

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# LLM Provider — "groq" (free, recommended) or "anthropic"
LLM_PROVIDER=groq

# Groq (free tier — sign up at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (alternative — paid)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# Escalation
ESCALATION_EMAIL=cs-manager@novacrm.com
